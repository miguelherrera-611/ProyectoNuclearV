# La regla ".env.production" de arriba es para el .env de producción del
# BACKEND (con secretos) — pero por nombre también atraparía el archivo de
# configuración de build de Vite del frontend, que no tiene ningún secreto
# (solo deja VITE_API_URL vacío) y hace falta que SÍ quede en git para que
# el build en CI/producción salga bien.
!/frontend/.env.production
